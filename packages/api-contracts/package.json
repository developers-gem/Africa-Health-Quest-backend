{
  "name": "@ahq/api-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared API contracts (zod schemas + OpenAPI) for the Africa Health Quest web, mobile and API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "openapi": "node ./dist/scripts/write-openapi.js ../../docs/api/openapi.json",
    "test:unit": "vitest run",
    "test": "vitest run"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.1.0",
    "zod": "^4.1.0",
    "@ahq/shared-types": "*"
  },
  "sideEffects": [
    "./dist/zod.js",
    "./dist/index.js"
  ]
}
