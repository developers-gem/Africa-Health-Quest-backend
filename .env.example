# Copy to apps/backend/.env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
MONGODB_URI=mongodb://localhost:27017/africaHealthQuest
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
# Reviewers and admins must use an authenticator app (TOTP). Disable only for local development.
MFA_REQUIRED_FOR_STAFF=true
STEP_UP_MAX_AGE_MINUTES=15
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
GUEST_TTL_DAYS=30
WEB_APP_URL=http://localhost:5173
# Comma-separated; defaults to WEB_APP_URL. Required in production.
CORS_ORIGINS=
# Number of proxy hops in front of the API (e.g. 1 behind an AWS ALB).
TRUST_PROXY=0
# log (dev only) | smtp
MAIL_TRANSPORT=log
# file: write each email (with its links) as JSON to MAIL_FILE_DIR — development/E2E only, refused in production.
# MAIL_FILE_DIR=./var/mail
SMTP_URL=
MAIL_FROM="Africa Health Quest <no-reply@example.org>"
# Comma-separated OAuth client IDs (web, Android, iOS). Empty disables Google sign-in.
GOOGLE_CLIENT_IDS=
# Mobile apps older than these versions are asked to update (returned by GET /api/v1/catalog).
MIN_APP_VERSION_ANDROID=0.1.0
MIN_APP_VERSION_IOS=0.1.0
# Background worker (npm run worker): schedule and retention.
WORKER_INTERVAL_MINUTES=60
ATTEMPT_MAX_AGE_DAYS=7
# AI learning debriefs (server-side only; never put this key in web or mobile code).
# AI_PROVIDER: anthropic | fake (deterministic local/test output, refused in production) | disabled.
# Defaults to "anthropic" when ANTHROPIC_API_KEY is set, otherwise "disabled".
AI_PROVIDER=
ANTHROPIC_API_KEY=
# Push notifications (Firebase Cloud Messaging). Base64 of the Firebase service-account JSON (server secret —
# never in the mobile app). Without it, notifications stay in the in-app inbox.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Uploaded media storage. "local" writes to MEDIA_STORAGE_DIR (development); production requires "s3".
MEDIA_STORAGE_DRIVER=local
MEDIA_STORAGE_DIR=./var/media
# S3 (production): private bucket; credentials come from the AWS default chain (ECS task role), never this file.
S3_MEDIA_BUCKET=
S3_MEDIA_PREFIX=media/
AWS_REGION=
# Local S3-compatible test server only (e.g. moto); leave empty for AWS.
S3_ENDPOINT=
# memory (one process) | mongo (sign-in limits shared by all API instances; required in production)
RATE_LIMIT_STORE=memory
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_API_MAX=600
# Failed sign-ins per email and failed two-factor codes per user, per window (shared when RATE_LIMIT_STORE=mongo).
RATE_LIMIT_ACCOUNT_MAX=10
