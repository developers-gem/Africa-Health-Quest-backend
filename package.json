{
  "name": "@ahq/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Africa Health Quest REST API (Express + MongoDB).",
  "type": "module",
  "main": "./dist/server.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build:packages": "npm run build -w @ahq/shared-types && npm run build -w @ahq/api-contracts && npm run build -w @ahq/game-content",
    "build": "npm run build:packages && tsc -p tsconfig.build.json && (if [ -f dist/src/server.js ] && [ ! -f dist/server.js ]; then cp -r dist/src/* dist/; fi)",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@ahq/api-contracts": "*",
    "@ahq/game-content": "*",
    "@ahq/shared-types": "*",
    "@anthropic-ai/sdk": "^1.4.0",
    "@aws-sdk/client-s3": "^3.1163.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^10.4.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.0",
    "nodemailer": "^10.3.1",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.2",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  }
}
